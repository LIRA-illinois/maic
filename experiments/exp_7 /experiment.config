# available GPUs to use in this experiment
# if empty, run_experiment will loop over all available GPUs on the computer
# array of integers
avail_gpus=()

# an experiment runs every seed within each scenario
# array of integers
seeds=(0 2289 3608)

# params that are the same across all scenarios in this experiment
# define as a string
same_params="
    test_interval=50000
    t_max=2000000
    test_nepisode=40
    runner=parallel
    env_args.field_size=10
    env_args.players=4
"

# params that can change across scenarios
# define as an array of strings with 1 alg and 1 env per scenario
rl_algs=(
    "maic"
    "maic"
    "qmix"
    "qmix"
    "qmix"
    "qmix"
)

envs=(
    "foraging-v2"
    "foraging-v2"
    "foraging"
    "foraging"
    "foraging"
    "foraging"
)

scenario_params=(
    "batch_size_run=2 batch_size=64"
    "batch_size_run=3 batch_size=96"
    "batch_size_run=2 batch_size=64"
    "batch_size_run=2 batch_size=64"
    "batch_size_run=2 batch_size=64"
    "batch_size_run=3 batch_size=96"
)


