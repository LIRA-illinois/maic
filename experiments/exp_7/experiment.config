# available GPUs to use in this experiment
# if empty, run_experiment will loop over all available GPUs on the computer
# array of integers
avail_gpus=(1 2 3)

# an experiment runs every seed within each scenario
# array of integers
seeds=(0 2289 3608)

# params that are the same across all scenarios in this experiment
# define as a string
same_params="
    test_interval=50000
    t_max=1000000
    t_max=2000000
    test_nepisode=50
"

# params that can change across scenarios
# define as an array of strings with 1 alg and 1 env per scenario
rl_algs=(
    "maic"
    "maic"
    "maic"
    "maic"
    "maic"
    "maic"
    "maic"
    "maic"
)


envs=(
    "join1"
    "join1-v0"
    "join1"
    "join1-v0"
    "join1"
    "join1-v0"
    "join1"
    "join1-v0"
)

scenario_params=(
    "runner=episode batch_size_run=1 batch_size=32"
    "runner=episode batch_size_run=1 batch_size=32"
    "runner=parallel batch_size_run=2 batch_size=64"
    "runner=parallel batch_size_run=2 batch_size=64"
    "runner=parallel batch_size_run=3 batch_size=96"
    "runner=parallel batch_size_run=3 batch_size=96"
    "runner=parallel batch_size_run=4 batch_size=128"
    "runner=parallel batch_size_run=4 batch_size=128"
)

